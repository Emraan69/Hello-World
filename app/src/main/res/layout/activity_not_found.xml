<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".NotFoundActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:elevation="0dp"
            app:title="@string/not_found_error_code"
            app:titleTextAppearance="@style/TextAppearance.App.Headline"
            app:navigationIcon="@drawable/ic_notification" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Error Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:contentPadding="32dp"
                style="@style/Widget.Material3.CardView.Filled">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <!-- Error Icon -->
                    <ImageView
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:src="@drawable/ic_error"
                        android:contentDescription="@string/not_found_title"
                        app:tint="?attr/colorError" />

                    <!-- Error Code -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/not_found_error_code"
                        android:textSize="48sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorError" />

                    <!-- Error Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/not_found_title"
                        android:textAppearance="@style/TextAppearance.App.Title"
                        android:textSize="24sp"
                        android:textColor="?attr/colorOnSurface" />

                    <!-- Error Message -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/not_found_message"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        android:textAlignment="center"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Suggestions Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/suggestions_title"
                android:textAppearance="@style/TextAppearance.App.Title"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="16dp" />

            <!-- Quick Actions Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:contentPadding="16dp"
                style="@style/Widget.Material3.CardView.Elevated">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Home Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGoHome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/suggestion_home"
                        app:icon="@drawable/ic_notification"
                        app:cornerRadius="12dp"
                        style="@style/Widget.Material3.Button.TonalButton" />

                    <!-- Notifications Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewNotifications"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/suggestion_notifications"
                        app:icon="@drawable/ic_inbox"
                        app:cornerRadius="12dp"
                        style="@style/Widget.Material3.Button.TonalButton" />

                    <!-- Settings Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenSettings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/suggestion_settings"
                        app:icon="@drawable/ic_settings"
                        app:cornerRadius="12dp"
                        style="@style/Widget.Material3.Button.TonalButton" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Recent Actions Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recent_actions_title"
                android:textAppearance="@style/TextAppearance.App.Title"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <!-- Quick Notification Actions Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:contentPadding="16dp"
                style="@style/Widget.Material3.CardView.Elevated">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Send Simple Notification -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSendNotification"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/send_simple_notification"
                        app:icon="@drawable/ic_notification"
                        app:cornerRadius="12dp"
                        style="@style/Widget.Material3.Button.OutlinedButton" />

                    <!-- Schedule Reminder -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScheduleReminder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/schedule_reminder"
                        app:icon="@drawable/ic_schedule"
                        app:cornerRadius="12dp"
                        style="@style/Widget.Material3.Button.OutlinedButton" />

                    <!-- Explore Features -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExploreFeatures"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/explore_features"
                        app:icon="@drawable/ic_action"
                        app:cornerRadius="12dp"
                        style="@style/Widget.Material3.Button.OutlinedButton" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
